# ============================================================================
# AI-for-DEV backend — configuration
#
# Copiez ce fichier en `.env` puis renseignez les valeurs.
# Les clés Azure OpenAI / Exa / Brave peuvent etre reprises telles quelles
# depuis le projet voisin : /Users/philippe/sources/poc/agent-infos/.env
#
# Ce fichier .env NE DOIT PAS etre commite (il est deja dans .gitignore).
# ============================================================================

# --- Azure OpenAI (LLM pour resumes & jugement de nouveaute) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-chat
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Recherche ---
EXA_API_KEY=
BRAVE_API_KEY=

# --- Options runtime (facultatif) ---
# Nombre max d'articles presentes par jour
MAX_ARTICLES_PER_DAY=5
# Profondeur de l'historique en jours
HISTORY_DAYS=14
# Fenetre de fraicheur : age maximum d'un article retenu, en jours
SEARCH_WINDOW_DAYS=7
# Penalite appliquee aux articles sans date de publication exploitable (0-1)
UNDATED_FRESHNESS_FACTOR=0.75
# Ponderer par la reception Hacker News (API publique, sans cle). true/false
ENABLE_HN_SIGNAL=true
